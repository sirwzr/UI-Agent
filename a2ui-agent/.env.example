# ===== LLM 配置 =====
# 当前使用的 LLM Provider: deepseek | openai | aliyun | gemini
LLM_PROVIDER=deepseek

# DeepSeek API (默认)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API (LLM_PROVIDER=openai 时使用)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# 阿里云 DashScope (LLM_PROVIDER=aliyun 时使用)
# 获取地址: https://dashscope.console.aliyun.com/apiKey
# 模型: qwen-turbo / qwen-plus / qwen-max
DASHSCOPE_API_KEY=sk-your-aliyun-key
ALIYUN_MODEL=qwen-plus

# Google Gemini (LLM_PROVIDER=gemini 时使用)
# 获取地址: https://aistudio.google.com/apikey
# 免费额度 1,500 次/天
# 模型: gemini-2.5-flash / gemini-2.5-pro
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# ===== 数据库 =====
DATABASE_URL=postgresql://a2ui:a2ui@localhost:5432/a2ui

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== NextAuth.js =====
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000

# Google OAuth Provider
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== 监控 =====
# Prometheus 指标端口 (由 Next.js 统一暴露在 /api/metrics)
GRAFANA_PASSWORD=admin

# ===== 联网搜索 =====
# 通义千问原生联网搜索 — 通过 DASHSCOPE_API_KEY 自动启用，无需额外注册
# Qwen 的 enable_search 参数让模型自动搜索互联网，返回实时信息
# 如需扩展其他搜索源，可添加以下 key（所有源合并去重）：
#   BRAVE_API_KEY — 免费 2000/月，https://brave.com/search/api/
#   BING_API_KEY — 免费 1000/月，https://portal.azure.com
#   SERPER_API_KEY — 付费，https://serper.dev
#   TAVILY_API_KEY — 免费 1000/月，https://tavily.com

# Pexels 图片/视频 API（补充高清图库和视频素材）
# 获取地址: https://pexels.com/api
# 免费 200 req/hr + 20,000/月
PEXELS_API_KEY=your-pexels-key

# ===== 应用 =====
NODE_ENV=development
LOG_LEVEL=info
