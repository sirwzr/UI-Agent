# ===== LLM 配置 =====
# 当前使用的 LLM Provider: deepseek | openai | gemini
LLM_PROVIDER=deepseek

# DeepSeek API (默认)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI API (LLM_PROVIDER=openai 时使用)
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini API (LLM_PROVIDER=gemini 时使用)
GEMINI_API_KEY=your-gemini-key

# ===== 数据库 =====
DATABASE_URL=postgresql://a2ui:a2ui@localhost:5432/a2ui

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== NextAuth.js =====
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000

# Google OAuth Provider
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== 监控 =====
# Prometheus 指标端口 (由 Next.js 统一暴露在 /api/metrics)
GRAFANA_PASSWORD=admin

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=tvly-your-key

# ===== 应用 =====
NODE_ENV=development
LOG_LEVEL=info
