{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "app/**/*.ts",
      "app/**/*.tsx",
      "lib/**/*.ts",
      "lib/**/*.tsx",
      "components/**/*.ts",
      "components/**/*.tsx",
      "stores/**/*.ts",
      "stores/**/*.tsx",
      "hooks/**/*.ts",
      "hooks/**/*.tsx",
      "prisma/**/*.ts",
      "tests/**/*.ts",
      "tools/**/*.ts",
      "tools/**/*.tsx",
      "monitoring/**/*.ts",
      "*.ts",
      "*.tsx",
      "*.json",
      "*.js",
      "*.mjs",
      "*.cjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": { "noUnusedVariables": "warn", "noUnusedImports": "warn", "noUnusedFunctionParameters": "warn" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
